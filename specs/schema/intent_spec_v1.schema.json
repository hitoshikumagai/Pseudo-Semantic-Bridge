{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pseudo-semantic-bridge.local/specs/schema/intent_spec_v1.schema.json",
  "title": "Intent Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "spec_version",
    "domain",
    "intent",
    "steps",
    "verification",
    "fallback"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "type": "string",
      "const": "1.0"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "default": {},
      "properties": {
        "mail_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_filter",
            "action_id"
          ],
          "properties": {
            "subject_filter": {
              "type": "string",
              "minLength": 1
            },
            "task_name": {
              "type": "string",
              "minLength": 1
            },
            "require_attachment": {
              "type": "boolean",
              "default": true
            },
            "target_ext": {
              "type": "string"
            },
            "action_id": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object",
              "default": {}
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object",
            "default": {}
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "min_quality_score"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "min_quality_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.8
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_failure"
      ],
      "properties": {
        "on_failure": {
          "type": "string",
          "minLength": 1,
          "default": "route_manual_review"
        }
      }
    }
  }
}
